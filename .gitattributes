# Normalise line endings so Windows and macOS checkouts produce identical diffs.
* text=auto eol=lf

# Gradle wrapper scripts generated by prebuild
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary

# Keep generated lockfile diffs out of review noise
package-lock.json linguist-generated=true
