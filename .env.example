# Zenter React Native app — environment variables
#
# Copy this file to `.env` before running the app:
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows)
#
# The two Supabase values below are the PUBLISHABLE (anon) credentials. They are
# meant to be shipped inside the client binary and are protected server-side by
# Postgres Row Level Security. They are safe to keep here.
# Never put the Supabase SERVICE ROLE key in this file or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://wppuzqaigtffcpuvjolt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Xx0JyGt9HuYDa4LHhEv41w_Bn5grq7a

# --- Optional ---------------------------------------------------------------

# Sentry crash reporting. Leave blank to disable — the app runs fine without it.
# EXPO_PUBLIC_SENTRY_DSN=

# Firebase native config paths. Defaults point at ./config/ (already in the
# repo), so you only need these to override for CI.
# GOOGLE_SERVICES_JSON=./config/google-services.json
# GOOGLE_SERVICES_PLIST=./config/GoogleService-Info.plist

# EAS. The project id is already committed in app.json; override only if you
# point the build at a different Expo account.
# EAS_PROJECT_ID=
# EAS_UPDATE_URL=
