# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects — generated by `npx expo prebuild`, never committed.
# Everything that shapes them lives in app.config.js.
/ios
/android

# Secrets / env — copy .env.example to .env instead
.env
.env.local
.env*.local
/secrets/
/credentials.json
/credentials/

# Metro
.metro-health-check*

# Supabase CLI local state (project link cache, not source)
/supabase/.temp/

# Vercel CLI local project link (unrelated to this app; leftover local state)
/.vercel/

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Signing material — NEVER commit
*.pem
*.p8
*.p12
*.key
*.jks
*.keystore
*.mobileprovision

# macOS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs and local scratch artifacts
*.log
*.png.tmp
